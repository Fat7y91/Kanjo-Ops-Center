rules_version = '2';

// Kanjo Ops Center — Cloud Storage rules.
//
// Generated contract PDFs are written exclusively by the Cloud Function using
// the Admin SDK (which bypasses these rules) and are shared with users through
// time-limited signed download URLs. Direct client reads/writes are therefore
// denied, and every other path is locked down as well.
service firebase.storage {
  match /b/{bucket}/o {
    match /contracts/{merchantId}/{fileName} {
      allow read: if false;
      allow write: if false;
    }

    // Vendor logos uploaded by scripts/sync-merchant-status.mjs (Admin SDK).
    // Public read so the agency portal can render them with a long-lived cache;
    // direct client writes remain denied.
    match /merchant-logos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
