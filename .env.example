# ─────────────────────────────────────────────────────────────────────────
# Kanjo Ops — Environment configuration template
# Copy this file to `.env` (which is gitignored) and fill in real values.
# In CI (GitHub Actions) the same variables should be configured as Actions
# Secrets; they are injected into the build by scripts/build-config.mjs.
# ─────────────────────────────────────────────────────────────────────────

# Google Apps Script Web App URL that receives merchant-document uploads and
# creates the per-merchant Google Drive folder. Must point to the /exec
# endpoint of the deployed web app (see scripts/drive/Code.gs).
KANJO_DRIVE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Shared token agreed with scripts/drive/Code.gs. NOTE: this ships in the
# public JS bundle because the browser must send it — it is obfuscation,
# not a real security boundary (real access control lives in Firestore
# rules and Drive account permissions). Generate a long random string:
#   openssl rand -hex 32
KANJO_DRIVE_SCRIPT_TOKEN=your-long-random-token-here

# ─────────────────────────────────────────────────────────────────────────
# Optional build-time values used by scripts/split-modules.mjs to inject the
# Firebase web config. These are public identifiers (not secrets) but they
# are kept out of source for hygiene. Fallbacks default to kanjo-desouk.
# ─────────────────────────────────────────────────────────────────────────
FIREBASE_API_KEY=AIzaSyBVYed19A7ob4M24oPK7P3-9vzH_iSRKZ0
# Same-origin as the app (web.app) so the Auth handler iframe is first-party
# and works under Safari ITP / cross-site-tracking prevention.
FIREBASE_AUTH_DOMAIN=kanjo-desouk.web.app
FIREBASE_PROJECT_ID=kanjo-desouk
FIREBASE_STORAGE_BUCKET=kanjo-desouk.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=253872156774
FIREBASE_APP_ID=1:253872156774:web:1d554b3bf0b78b98c77da7
FIREBASE_MEASUREMENT_ID=G-FBM6G2RF1B
FIREBASE_APP_CHECK_SITE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# V2 Next.js app — session signing
# Sign the capability session cookie. Use a long random value in production:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-value

# ─────────────────────────────────────────────────────────────────────────
# V2 Next.js app — Hybrid database layer (src/lib/db/)
#
# Supabase = Financial / ERP only: users, RBAC, ledgers, wallets, commissions.
# Firebase = Operations only: catalog, orders, field ops.
# All values are read lazily, so the app boots without them; anything that
# touches a repository will fail fast with MissingEnvError until they are set.
# ─────────────────────────────────────────────────────────────────────────

# Supabase project (Settings → API). The service-role key bypasses RLS and must
# never be exposed with a NEXT_PUBLIC_ prefix.
# Login needs all three: the anon key verifies the password, the service-role
# key reads the profile back from the `app` schema.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─────────────────────────────────────────────────────────────────────────
# One-shot Founder bootstrap (GET /api/admin/bootstrap)
#
# Used once, from a browser, after the RBAC migrations are applied. The route
# stops working as soon as an active governor exists, so these values are only
# needed during first-time setup. BOOTSTRAP_PASSWORD is never committed — set it
# in the hosting dashboard, hit the URL, then remove both variables.
# BOOTSTRAP_TOKEN is optional; when set, the request must pass ?token=<value>.
# ─────────────────────────────────────────────────────────────────────────
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TOKEN=
# Optional override; defaults to the founder number baked into the route.
BOOTSTRAP_PHONE=

# Firebase web config (public identifiers, inlined at build time).
# Note: distinct from the legacy FIREBASE_* keys used by public/js/config.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Firebase Admin credentials (Node runtime only; not available on Edge).
# Provide either the discrete trio or FIREBASE_SERVICE_ACCOUNT as one JSON blob.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

