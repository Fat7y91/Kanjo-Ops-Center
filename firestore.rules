rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // Kanjo Operations Center — Firestore Security Rules (RBAC)
    // ═══════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = custom claim role 'admin' OR uid listed in app_security/admins
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/app_security/admins) &&
         get(/databases/$(database)/documents/app_security/admins).data.uids is list &&
         get(/databases/$(database)/documents/app_security/admins).data.uids.hasAny([request.auth.uid]))
      );
    }

    // 1) Global default: deny everything.
    match /{document=**} {
      allow read, write: if false;
    }

    // 2) Sensitive collections (Contracts & Commissions)
    // - Read: Allowed for all authenticated users so dashboard stats can compute correctly.
    // - Write/Update/Delete: STRICTLY ADMIN ONLY.
    match /contracts/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /commissions/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // Merchant records (Unique Merchant ID + official documents).
    // The permanent merchantId is the docId. Anyone signed in may CREATE a
    // record ONLY for its own matching merchantId, and UPDATE only the
    // display/document fields (name, drive folder binding) so the Google
    // Drive link can be saved back after a successful upload. Deleting is
    // admin-only. The immutable merchantId itself is never editable.
    // ───────────────────────────────────────────────────────────────
    match /merchants/{docId} {
      function isMerchantDocForItself() {
        return request.resource.data.merchantId == docId;
      }

      function merchantUpdateTouchesOnlyDocumentFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'driveFolderId', 'driveFolderLink', 'docsUpdatedAt', 'docsUpdatedBy', 'documents'
        ]);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isMerchantDocForItself();
      allow update: if isAdmin()
        || (isSignedIn() && merchantUpdateTouchesOnlyDocumentFields());
      allow delete: if isAdmin();
    }

    // 3) Operational collections used by the dashboard app.
    match /tasks/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Public landing page — merchant lead registration form.
    // Anyone signed in (incl. anonymous) may CREATE a lead; reads, updates
    // and deletes are STRICTLY ADMIN ONLY so captured lead data stays private.
    match /merchant_leads/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{docId} {
      allow read, write: if isSignedIn();
    }

    match /transferRequests/{docId} {
      allow read, write: if isSignedIn();
    }

    match /financial_profiles/{docId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{docId} {
      allow read, write: if isSignedIn();
    }

    match /archivedReports/{docId} {
      allow read, write: if isSignedIn();
    }

    // ───────────────────────────────────────────────────────────────
    // Product catalog pipeline (`merchant_products`).
    // Assumed fields:
    //   merchantId, merchantName, name_ar, description_ar (string, required)
    //   base_price (number, required, >= 0)
    //   category (string, required)
    //   rawImageUrl (https URL, required on create)
    //   enhancedImageUrl (string URL or empty)
    //   status: 'pending' | 'done' (default pending)
    // Auth is anonymous + PIN, so identity RBAC lives in the client;
    // rules still require sign-in, typed fields, size limits, and
    // restrict status transitions (pending -> done) plus URL shapes.
    // ───────────────────────────────────────────────────────────────
    match /merchant_products/{docId} {
      function isValidHttpsUrl(value) {
        return value is string
          && value.size() > 8
          && value.size() <= 2048
          && value.matches('^https://.*');
      }

      function isValidOptionalUrl(value) {
        return value is string
          && value.size() <= 2048
          && (value.size() == 0 || value.matches('^https://.*'));
      }

      function isValidCatalogProduct() {
        let d = request.resource.data;
        return d.keys().hasAll([
            'merchantId', 'merchantName', 'name_ar', 'description_ar',
            'base_price', 'category', 'rawImageUrl', 'enhancedImageUrl', 'status'
          ])
          && d.keys().hasOnly([
            'merchantId', 'merchantName', 'name_ar', 'description_ar',
            'base_price', 'category', 'rawImageUrl', 'enhancedImageUrl', 'status',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ])
          && d.merchantId is string && d.merchantId.size() > 0 && d.merchantId.size() <= 80
          && d.merchantName is string && d.merchantName.size() > 0 && d.merchantName.size() <= 200
          && d.name_ar is string && d.name_ar.size() > 0 && d.name_ar.size() <= 200
          && d.description_ar is string && d.description_ar.size() > 0 && d.description_ar.size() <= 2000
          && d.base_price is number && d.base_price >= 0 && d.base_price <= 100000000
          && d.category is string && d.category.size() > 0 && d.category.size() <= 120
          && isValidHttpsUrl(d.rawImageUrl)
          && isValidOptionalUrl(d.enhancedImageUrl)
          && d.status in ['pending', 'done']
          && (!('createdBy' in d) || (d.createdBy is string && d.createdBy.size() <= 120))
          && (!('updatedBy' in d) || (d.updatedBy is string && d.updatedBy.size() <= 120))
          && (!('createdAt' in d) || d.createdAt is timestamp)
          && (!('updatedAt' in d) || d.updatedAt is timestamp)
          && (d.status == 'pending'
              ? d.enhancedImageUrl.size() == 0
              : isValidHttpsUrl(d.enhancedImageUrl));
      }

      function catalogCreateIsPending() {
        return request.resource.data.status == 'pending'
          && request.resource.data.enhancedImageUrl.size() == 0;
      }

      function catalogUpdateIsEnhanceOrAdmin() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return isAdmin()
          || (resource.data.status == 'pending'
              && request.resource.data.status == 'done'
              && changed.hasOnly(['enhancedImageUrl', 'status', 'updatedAt', 'updatedBy'])
              && isValidHttpsUrl(request.resource.data.enhancedImageUrl));
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidCatalogProduct() && catalogCreateIsPending();
      allow update: if isSignedIn() && isValidCatalogProduct() && catalogUpdateIsEnhanceOrAdmin();
      allow delete: if isAdmin();
    }

    // 4) Admin allowlist bootstrap.
    match /app_security/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && docId == 'admins'
        && !exists(/databases/$(database)/documents/app_security/admins);
      allow update, delete: if isAdmin();
    }
  }
}
